{
  "name": "sf-wedding",
  "version": "0.1.0",
  "private": true,
  "description": "SF Wedding — a single-page, red-thread wedding invitation for Flemy and Sebastian, built with Next.js.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON content/verify.ts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generators/generate-images.mjs --only=rituals",
    "build": "next build",
    "lint": "biome check",
    "format": "biome format --write",
    "frames": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generators/build-frame-css.ts",
    "images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generators/generate-images.mjs",
    "og:card": "node scripts/generators/build-og-card.mjs",
    "trace:motif": "node scripts/thread/trace-motif.mjs",
    "thread:import": "node scripts/thread/import-thread-drawing.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test content/*.test.ts 'components/**/*.test.ts' 'app/**/*.test.ts' 'scripts/**/*.test.mjs' 'scripts/**/*.test.ts'",
    "validate:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON content/verify.ts",
    "verify:section": "node scripts/gates/verify-section.mjs",
    "measure:fit": "node scripts/generators/measure-section-fit.mjs",
    "check:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gates/check-export-routes.mjs",
    "check:retire": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/gates/retire-register.test.mjs",
    "check:thread": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gates/check-thread-clearance.mjs",
    "check:thread-joins": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gates/check-thread-joins.mjs",
    "check:thread-layout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gates/check-thread-layout-impact.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@playwright/cli": "^0.1.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "1.62.0-alpha-1783623505000",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18 <23"
  }
}
